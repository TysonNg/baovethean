# Chuỗi kết nối PostgreSQL cho Payload (KHÔNG commit giá trị thật).
# Khớp với service trong docker-compose.yml khi chạy local.
DATABASE_URI=postgres://postgres:postgres@localhost:5432/baovethean

# Chuỗi bí mật để Payload ký cookie/token. Tạo chuỗi ngẫu nhiên đủ dài cho production.
# Ví dụ tạo: openssl rand -base64 32
PAYLOAD_SECRET=

# URL server nội bộ (dùng cho Local API / admin). Local: http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# URL public của website (dùng cho canonical/sitemap/SEO). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Token bí mật cho chức năng preview bản nháp trong admin (tạo chuỗi ngẫu nhiên).
# Ví dụ tạo: openssl rand -base64 24
PAYLOAD_PREVIEW_SECRET=

# SMTP dùng để gửi form liên hệ. Không commit thông tin đăng nhập thật.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bảo vệ Thế An <contact@baovethean.vn>"
CONTACT_TO=contact@baovethean.vn
