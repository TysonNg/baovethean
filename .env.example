# PostgreSQL (KHÔNG commit giá trị thật). Tạo mật khẩu URL-safe bằng:
# openssl rand -hex 32
POSTGRES_USER=baovethean
POSTGRES_PASSWORD=
POSTGRES_DB=baovethean
POSTGRES_PORT=5432

# Chuỗi kết nối PostgreSQL cho Payload. Thay <POSTGRES_PASSWORD> bằng mật
# khẩu ở trên; PostgreSQL chỉ được bind tại 127.0.0.1.
DATABASE_URI=postgres://baovethean:<POSTGRES_PASSWORD>@127.0.0.1:5432/baovethean

# Chuỗi bí mật để Payload ký cookie/token. Tạo chuỗi ngẫu nhiên đủ dài cho production.
# Ví dụ tạo: openssl rand -base64 32
PAYLOAD_SECRET=

# URL server public. Local có thể đổi thành http://localhost:3000
NEXT_PUBLIC_SERVER_URL=https://baovethean.com

# URL public của website. Local có thể đổi thành http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://baovethean.com

# Google Analytics 4 Measurement ID (ví dụ: G-XXXXXXXXXX). Biến này được đưa
# vào trình duyệt khi build, không dùng để lưu khóa bí mật.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Mã xác minh HTML-tag từ Google Search Console. Có thể nhập trong Payload CMS
# thay vì biến này; biến môi trường được ưu tiên khi cả hai cùng tồn tại.
GOOGLE_SITE_VERIFICATION=

# Token bí mật cho chức năng preview bản nháp trong admin (tạo chuỗi ngẫu nhiên).
# Ví dụ tạo: openssl rand -base64 24
PAYLOAD_PREVIEW_SECRET=

# SMTP dùng để gửi form liên hệ. Không commit thông tin đăng nhập thật.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bảo vệ Thế An <baovethean@gmail.com>"
CONTACT_TO=baovethean@gmail.com
